<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        app:title="@string/app_name"
        app:titleTextColor="@color/text_primary"
        app:subtitle="@string/app_subtitle"
        app:subtitleTextColor="@color/text_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:text="@string/status_connected"
            android:textColor="@color/accent_secondary"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/bg_dark"
            app:chipStrokeColor="@color/border_color"
            app:chipStrokeWidth="1dp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Top Global Progress Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/globalProgressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/accent_primary"
        app:trackColor="@color/border_color"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content Container (Frames for Native Tabs) -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/globalProgressBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ================= TAB 1: TTS VOICE STUDIO ================= -->
        <ScrollView
            android:id="@+id/viewTtsStudio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Quick Presets Carousel -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نمونہ کلام (Quick Poetry Presets):"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipIqbal"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_iqbal_title"
                            android:textColor="@color/text_primary"
                            app:chipBackgroundColor="@color/card_dark"
                            app:chipStrokeColor="@color/border_color" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipGhalib"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_ghalib_title"
                            android:textColor="@color/text_primary"
                            app:chipBackgroundColor="@color/card_dark"
                            app:chipStrokeColor="@color/border_color" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFaiz"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_faiz_title"
                            android:textColor="@color/text_primary"
                            app:chipBackgroundColor="@color/card_dark"
                            app:chipStrokeColor="@color/border_color" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Input Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_input_text"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutText"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@color/bg_dark"
                            app:boxStrokeColor="@color/accent_primary"
                            app:hintTextColor="@color/text_secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etInputText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_enter_text"
                                android:inputType="textMultiLine"
                                android:gravity="top|start"
                                android:lines="4"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Voice Artist Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_select_voice"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/groupVoices"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVoiceAoede"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="Aoede (خاتون • شاعرانہ)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVoiceKore"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Kore (خاتون • قدرتی)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVoiceFenrir"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fenrir (مردانہ • باوقار)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVoiceCharon"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Charon (مردانہ • گہرا)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVoicePuck"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Puck (نوجوان • پرجوش)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVoicePari"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pari (بچی کی آواز)"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Style & Emotion Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_select_style"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/groupStyles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStylePoetic"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="شاعرانہ و ترنم (Poetic)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleDramatic"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="پرجوش و ڈرامائی (Dramatic)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleEmotional"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="محبت و گداز (Emotional Soft)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleFormal"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="سنجیدہ و باوقار (Formal)"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleConversational"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="عام گفتگو (Conversational)"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sliders Card (Speed & Pitch) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvSpeedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="رفتار (Speed): 1.0x"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.5"
                            android:valueTo="2.0"
                            android:stepSize="0.1"
                            android:value="1.0"
                            app:thumbColor="@color/accent_primary"
                            app:trackColorActive="@color/accent_primary"
                            app:trackColorInactive="@color/border_color" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Generate Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateVoice"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_generate_voice"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_sparkles"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/accent_primary"
                    android:layout_marginBottom="16dp" />

                <!-- Native Player Card (Appears when audio is ready) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/accent_primary"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvPlayerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="آواز تیار ہے (Audio Ready)"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <SeekBar
                            android:id="@+id/seekBarAudio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:progressTint="@color/accent_secondary"
                            android:thumbTint="@color/accent_secondary"
                            android:layout_marginBottom="12dp" />

                        <!-- Controls Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlayPause"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/btn_play"
                                app:icon="@drawable/ic_play"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/accent_primary"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveAudio"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="محفوظ کریں"
                                app:icon="@drawable/ic_download"
                                app:cornerRadius="12dp"
                                android:textColor="@color/text_primary"
                                app:strokeColor="@color/border_color"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnShareAudio"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="شیئر"
                                app:icon="@drawable/ic_share"
                                app:cornerRadius="12dp"
                                android:textColor="@color/text_primary"
                                app:strokeColor="@color/border_color" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 2: POETRY & METER STUDIO ================= -->
        <ScrollView
            android:id="@+id/viewPoetryStudio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_poetry"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="علمِ عروض اور تقطیع کی مدد سے اپنی شاعری کی بحر اور اوزان جانچیں"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@color/bg_dark"
                            app:boxStrokeColor="@color/accent_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPoetryInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_poetry_input"
                                android:lines="3"
                                android:gravity="top|start"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAnalyzePoetry"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_analyze_poetry"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/accent_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Poetry Analysis Result Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPoetryResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/accent_secondary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvBahrName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="بحر کا نام: بحرِ رمل مثمن محذوف"
                            android:textColor="@color/accent_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvTaqtee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="وزن / تقطیع: فاعلاتن فاعلاتن فاعلاتن فاعلن"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReciteFromPoetry"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/btn_recite_poetry"
                            app:icon="@drawable/ic_voice"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/accent_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 3: SAVED AUDIO LIBRARY ================= -->
        <ScrollView
            android:id="@+id/viewLibraryStudio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_library"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تمام محفوظ کی گئی آڈیو فائلز (Music/AwaazAI)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/layoutSavedItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Empty state notice -->
                    <TextView
                        android:id="@+id/tvEmptyLibrary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_library"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="32dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 4: SETTINGS & STUDIO SYNC ================= -->
        <ScrollView
            android:id="@+id/viewSettingsStudio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_server_url"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvConnectedServerUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="https://ais-dev-5cvx4c33evmpc66n564nmm-904497767506.asia-east1.run.app"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchOfflineOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_offline_switch"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desc_offline_switch"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Advanced Web Studio Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ایڈوانسڈ ویڈیو و ڈائریکٹر موڈ"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="اگر آپ مکمل ڈیسک ٹاپ ٹولز (جیسے AI ویڈیو تخلیق، سب ٹائٹلز جنریٹر یا ڈاکومنٹ نیریٹر) استعمال کرنا چاہتے ہیں تو ویب اسٹوڈیو کھولیں۔"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenWebStudio"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/btn_open_web_studio"
                            app:cornerRadius="12dp"
                            android:textColor="@color/accent_secondary"
                            app:strokeColor="@color/accent_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/app_version_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="20dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Optional Web Studio Overlay (when user explicitly requests it) -->
        <FrameLayout
            android:id="@+id/layoutWebStudioOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_dark"
            android:visibility="gone">

            <WebView
                android:id="@+id/webViewStudio"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCloseWebStudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:contentDescription="Close Web Studio"
                app:srcCompat="@drawable/ic_stop"
                app:tint="@color/text_primary"
                app:backgroundTint="@color/card_dark" />
        </FrameLayout>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        app:itemIconTint="@color/text_primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
